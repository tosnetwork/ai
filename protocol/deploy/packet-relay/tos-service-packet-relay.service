[Unit]
Description=TOS Service Protocol Agent Packet Relay V1 mailbox
Documentation=https://github.com/tosnetwork/ai/tree/main/protocol/deploy/packet-relay
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
# The relay holds no key and needs no chain RPC: its only inputs are this
# command line, the TLS certificate and its own state directory.
#
# The global limits are required and have no default. Size them to the disk
# given to the state directory: every stored envelope costs at most 256 KiB
# plus a 73-byte record header, a tombstone 112 bytes, and each entry about
# 300 bytes of memory in the index.
ExecStart=/usr/local/bin/tos-service-packet-relay \
  -listen [::]:443 \
  -tls-cert ${CREDENTIALS_DIRECTORY}/tls-cert \
  -tls-key ${CREDENTIALS_DIRECTORY}/tls-key \
  -state-dir /var/lib/tos-service-packet-relay \
  -global-max-entries 100000 \
  -global-max-bytes 4294967296 \
  -max-connections 1024 \
  -max-connections-per-client 16 \
  -max-connections-per-48 64
# The certificate and key are copied into a private credentials directory
# readable only by the service; rotate them in place and restart.
LoadCredential=tls-cert:/etc/tos-service/packet-relay/tls-cert.pem
LoadCredential=tls-key:/etc/tos-service/packet-relay/tls-key.pem
Restart=on-failure
RestartSec=5s
# Shutdown waits up to 10 s for in-flight requests; every accepted write is
# already durable, so a kill past this limit loses nothing acknowledged.
TimeoutStopSec=20s

DynamicUser=yes
# Envelopes, tombstones and the index survive restarts here. Removing the
# directory drops every pending envelope; senders' redelivery recovers.
StateDirectory=tos-service-packet-relay
StateDirectoryMode=0700
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# At most -max-concurrent-deposits (default 256) deposit bodies of 256 KiB
# are held at once, whatever the connections or HTTP/2 streams: about
# 64 MiB, plus the index (about 300 bytes per entry, 30 MiB at the limits
# above) and connection buffers. GOMEMLIMIT keeps the collector below
# MemoryMax. Raise them together.
Environment=GOMEMLIMIT=384MiB
MemoryMax=512M
MemorySwapMax=0
TasksMax=256
LimitNOFILE=4096

RestrictAddressFamilies=AF_INET AF_INET6
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=no
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
