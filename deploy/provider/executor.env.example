# /etc/tos-service/executor.env (root:root 0600), read by
# tos-service-executor.service. Numeric ids only; names are not resolved.

# Comma-separated uids that may call the executor. Each of them can make
# root run one bounded sandboxed job at a time under the frozen policy and
# store its bounded result. There is no "any local user" setting: an empty
# list refuses to start.
TOS_EXECUTOR_ALLOWED_UIDS=

# The one gid given access to the service socket and its directory. Use a
# dedicated group whose only members are the allowed users.
TOS_EXECUTOR_SOCKET_GID=
