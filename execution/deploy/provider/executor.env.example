# /etc/tos-service/executor.env (root:root 0600), read by
# tos-service-executor.service. Numeric ids only; names are not resolved.

# The one uid that may call the executor: the provider node's user. It can
# make root run one bounded sandboxed job at a time under the frozen policy
# and store its bounded result. Exactly one uid: an empty value, a list or a
# name refuses to start, and there is no "any local user" setting.
TOS_EXECUTOR_ALLOWED_UID=

# The one gid given access to the service socket and its directory. Use a
# dedicated group whose only member is the allowed user.
TOS_EXECUTOR_SOCKET_GID=
